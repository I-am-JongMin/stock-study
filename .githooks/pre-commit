#!/bin/sh
#
# 커밋 전 비밀정보 차단 (§F — 운영 안전)
#
# 이 저장소는 공개(public)다. 한 번 푸시된 비밀은 되돌릴 수 없다 —
# 커밋을 지워도 GitHub 는 orphan commit 을 한동안 보관하고,
# 공개 저장소는 봇이 수 초 안에 긁어간다.
#
# .gitignore 는 "실수로 add 하지 않게" 도와줄 뿐, `git add -f` 나
# application.yml 에 직접 박아넣는 경로는 막지 못한다. 그 두 경로를 여기서 막는다.
#
# 검사 대상은 **스테이징된 추가 라인**뿐이다. 과거 이력은 보지 않는다.
#
set -eu

RED=''
YELLOW=''
RESET=''
if [ -t 2 ]; then
    RED=$(printf '\033[31m')
    YELLOW=$(printf '\033[33m')
    RESET=$(printf '\033[0m')
fi

fail() {
    printf '%s커밋이 차단되었습니다 — 비밀정보로 보이는 내용이 있습니다.%s\n\n' "$RED" "$RESET" >&2
    cat >&2
    printf '\n%s오탐이라면 해당 줄 끝에 주석으로 다음을 붙이세요:%s\n' "$YELLOW" "$RESET" >&2
    printf '    pragma: allowlist secret\n\n' >&2
    printf '%s훅 자체를 건너뛰려면 git commit --no-verify 지만, 공개 저장소에서는 권하지 않습니다.%s\n' "$YELLOW" "$RESET" >&2
    exit 1
}

# ── 1. .env 파일 자체가 스테이징된 경우 ──
# .gitignore 에 있어도 `git add -f` 로 들어올 수 있다.
staged_env=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '(^|/)\.env($|\.[^/]*$)' \
    | grep -vE '(^|/)\.env\.example$' || true)

if [ -n "$staged_env" ]; then
    fail <<EOF
  .env 파일이 스테이징되어 있습니다:

$(printf '    %s\n' $staged_env)

  이 파일은 커밋하지 않습니다. 템플릿이 필요하면 .env.example 을 고치세요.

      git restore --staged $staged_env
EOF
fi

# ── 2. 추가된 라인에서 비밀정보 패턴 찾기 ──
# 훅 자신과 템플릿은 제외한다. 둘 다 패턴 문자열을 당연히 포함한다.
scan=$(git diff --cached -U0 --diff-filter=ACM -- \
        ':(exclude).githooks/**' \
        ':(exclude).env.example' \
    | grep -E '^\+' \
    | grep -vE '^\+\+\+' \
    | grep -vE 'pragma: allowlist secret' \
    | grep -vE '(YOUR_|your-|your_|CHANGEME|changeme|placeholder|PLACEHOLDER|<[^>]*>)' \
    || true)

if [ -n "$scan" ]; then
    # 값이 실제로 채워진 환경변수 할당.
    # ${...} 보간과 빈 값은 통과시킨다.
    hits=$(printf '%s\n' "$scan" | grep -nE \
        '(KIS_APP_KEY|KIS_APP_SECRET|KIS_ACCOUNT_NO|TELEGRAM_BOT_TOKEN)[[:space:]]*=[[:space:]]*[^[:space:]$]' \
        || true)

    # YAML/properties 에 직접 박아넣은 경우. 16 자 이상이면 placeholder 가 아니다.
    hits="$hits$(printf '%s\n' "$scan" | grep -nE \
        '(app-?key|app-?secret|appKey|appSecret|bot-?token)[[:space:]]*:[[:space:]]*["'"'"']?[A-Za-z0-9/+=_-]{16,}' \
        || true)"

    # 발급자가 정해진 토큰 형식들. 이건 형태만으로 확실하다.
    hits="$hits$(printf '%s\n' "$scan" | grep -nE \
        'gh[pousr]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----' \
        || true)"

    hits=$(printf '%s\n' "$hits" | grep -v '^$' || true)

    if [ -n "$hits" ]; then
        fail <<EOF
  스테이징된 추가 라인에서 발견:

$(printf '%s\n' "$hits" | sed 's/^/    /')

  키는 .env 에 넣고 설정에서는 환경변수로 참조하세요:

      kis:
        app-key: \${KIS_APP_KEY}
EOF
    fi
fi

exit 0
