# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 로컬 인프라 값들은 docker-compose.yml 과 일치하므로 그대로 두면 된다.

# ── 로컬 인프라 (기본값으로 충분) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockstudy
DB_USERNAME=stockstudy
DB_PASSWORD=stockstudy

REDIS_HOST=localhost
REDIS_PORT=6379

SERVER_PORT=8080

# ── 한국투자증권 KIS Open API (Phase 1 부터 필요) ──
# https://apiportal.koreainvestment.com 에서 발급한다.
# 모의투자 계좌로도 실시간 시세를 받을 수 있다 (ADR-012).
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# 모의투자: https://openapivts.koreainvestment.com:29443
# 실전투자: https://openapi.koreainvestment.com:9443
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# ── 알림 (Phase 4 부터 필요) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
