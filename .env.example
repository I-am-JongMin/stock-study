# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 로컬 인프라 값들은 docker-compose.yml 과 일치하므로 그대로 두면 된다.

# ── 로컬 인프라 (기본값으로 충분) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockstudy
DB_USERNAME=stockstudy
DB_PASSWORD=stockstudy

REDIS_HOST=localhost
REDIS_PORT=6379

SERVER_PORT=8080

# ── 키움 REST API (Phase 1 부터 필요) ──
# https://openapi.kiwoom.com 에서 발급한다 (ADR-021). 절차는 docs/next-steps.md §3.1.
# 실전과 모의는 앱키·앱시크릿·도메인이 전부 별개다 — 모의투자용 키를 넣는다 (ADR-020).
# App Key·Secret 다운로드는 발급 후 1 회만 가능하니 받자마자 여기에 보관한다.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=
# 모의투자: https://mockapi.kiwoom.com   (웹소켓 wss://mockapi.kiwoom.com:10000)
# 실전투자: https://api.kiwoom.com       (웹소켓 wss://api.kiwoom.com:10000)
KIWOOM_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_WS_URL=wss://mockapi.kiwoom.com:10000

# ── 알림 (Phase 4 부터 필요) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
